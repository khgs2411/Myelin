{
  "stage": "impact",
  "agent_kind": "llm-agent",
  "token_budget_input": 60000,
  "token_budget_output": 8000,
  "on_over_budget": "fail-clean",
  "stage_specific": {
    "ranking_cutoff": 20,
    "entry_point_patterns": [
      "**/main.py",
      "**/__main__.py",
      "**/app.py",
      "**/index.ts",
      "**/index.js",
      "**/Program.cs",
      "**/main.go",
      "**/main.rs"
    ],
    "meta_doc_patterns": [
      "README*",
      "docs/**/*.md",
      "pyproject.toml",
      "package.json",
      "Cargo.toml",
      "go.mod"
    ]
  }
}
