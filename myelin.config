# Default provider when MODEL is unset.
DEFAULT_PROVIDER=codex

# Project learn/ingest stages build and maintain project memory.
PIPELINE_CODEX_MODEL=gpt-5.5
# PIPELINE_CODEX_MODEL=gpt-5.4-mini
PIPELINE_CODEX_REASONING_EFFORT=medium

# Query surfaces traverse existing memory metadata and pages.
QUERY_CODEX_MODEL=gpt-5.4-mini
QUERY_CODEX_REASONING_EFFORT=xhigh

PIPELINE_CLAUDE_MODEL=claude-sonnet-4-7
QUERY_CLAUDE_MODEL=claude-haiku-4-5

# Experience Log to Session Memory ingest.
INGEST_BATCH_SIZE=100
INGEST_WORKER_CONCURRENCY=1
INGEST_WORKER_START_DELAY_MS=750
INGEST_LLM_TIMEOUT_MS=600000
INGEST_PROMPT_CHAR_LIMIT=180000
INGEST_CODEX_MODEL=gpt-5.4-mini
INGEST_CODEX_REASONING_EFFORT=medium
# INGEST_CLAUDE_MODEL=claude-sonnet-4-7

# Session Memory embedding/indexing.
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_GEMINI_MODEL=gemini-embedding-2
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_STUB_RESPONSES_DIR=
# GOOGLE_API_KEY is read from .env or the environment, not checked into this file.
# GEMINI_API_KEY is also accepted as a compatibility alias.

# Auto Session Memory maintenance.
# Disabled by default; when enabled, capture hooks schedule a detached maintenance worker
# after enough queued Experience Log rows exist. The worker runs ingest, waits for the
# ingest drain to finish, and indexes pending Session Memory embeddings.
AUTO_MEMORY_MAINTENANCE=1
AUTO_MEMORY_MIN_CAPTURED_EVENTS=100
AUTO_MEMORY_COOLDOWN_MS=300000
AUTO_MEMORY_DRAIN_POLL_INTERVAL_MS=5000
AUTO_MEMORY_DRAIN_TIMEOUT_MS=600000
AUTO_MEMORY_INDEX_LIMIT=500

# Optional SQLite dylib override for macOS extension loading.
# Myelin uses its vendored SQLite runtime when available and falls back to Homebrew SQLite on macOS.
# MYELIN_SQLITE_DYLIB_PATH=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib
