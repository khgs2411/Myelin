# Default provider when MODEL is unset.
DEFAULT_PROVIDER=codex

# Project learn/ingest stages build and maintain project memory.
PIPELINE_CODEX_MODEL=gpt-5.6-terra
# PIPELINE_CODEX_MODEL=gpt-5.5
# PIPELINE_CODEX_MODEL=gpt-5.4-mini
PIPELINE_CODEX_REASONING_EFFORT=high

# Query surfaces traverse existing memory metadata and pages.
QUERY_CODEX_MODEL=gpt-5.6-terra
# QUERY_CODEX_MODEL=gpt-5.5
# QUERY_CODEX_MODEL=gpt-5.4-mini
QUERY_CODEX_REASONING_EFFORT=medium

PIPELINE_CLAUDE_MODEL=claude-sonnet-4-7
QUERY_CLAUDE_MODEL=claude-haiku-4-5

# Experience Log to Session Memory maintenance. This controls internal evidence selection,
# not durable job grouping; each invocation creates one ingest job.
INGEST_EVIDENCE_CHUNK_SIZE=10
INGEST_LLM_TIMEOUT_MS=600000
INGEST_PROMPT_CHAR_LIMIT=180000
INGEST_CODEX_MODEL=gpt-5.4-mini
INGEST_CODEX_REASONING_EFFORT=medium
# INGEST_CLAUDE_MODEL=claude-sonnet-4-7

# Explicit Session Memory curator plan for this repository. These are required
# together; there are intentionally no cross-repository defaults.
SMC_MAX_ITEMS_PER_BATCH=10
SMC_MAX_ENCODED_BYTES_PER_BATCH=100000
SMC_MAX_ENCODED_BYTES_PER_ITEM=100000
SMC_AUDIT_PARTITION_LIMIT=10
SMC_MAX_AFFECTED_WORK_SET_SIZE=1000
SMC_MAX_CUMULATIVE_RETURNED_RESULT_BYTES=100000
SMC_MAX_PROVIDER_ENVELOPE_BYTES=180000
SMC_MAX_QUERIES=1010
SMC_MAX_TURNS=20
SMC_RETRIEVAL_PAGE_ITEM_LIMIT=100
SMC_SEMANTIC_DISTANCE_THRESHOLD_MICROS=800000
SMC_SEMANTIC_QUALIFYING_RESULT_CEILING=1000

# Session Memory embedding/indexing.
EMBEDDING_PROVIDER=ollama_nomic
# EMBEDDING_NOMIC_MODEL=nomic-embed-text:v1.5
# EMBEDDING_NOMIC_DIMENSIONS=768
# EMBEDDING_QWEN_MODEL=qwen3-embedding:4b
# EMBEDDING_QWEN_DIMENSIONS=768
# EMBEDDING_GEMINI_MODEL=gemini-embedding-2
# EMBEDDING_GEMINI_DIMENSIONS=768
EMBEDDING_OLLAMA_URL=http://127.0.0.1:11434
# EMBEDDING_BATCH_SIZE=50
# EMBEDDING_STUB_RESPONSES_DIR=
# GOOGLE_API_KEY is read from .env or the environment, not checked into this file.
# GEMINI_API_KEY is also accepted as a compatibility alias.
# auto selects an available local provider once per memory scope, persists it, and never selects Google.
# Gemini is available only through explicit EMBEDDING_PROVIDER=gemini configuration.

# Auto Session Memory maintenance.
# Disabled by default; when enabled, capture hooks schedule a detached maintenance worker
# after enough queued valid content entries exist. A session-start control signal may request
# a below-threshold drain without being persisted. The worker runs ingest, waits for the
# ingest drain to finish, and indexes pending Session Memory embeddings.
AUTO_MEMORY_MAINTENANCE=1
AUTO_MEMORY_MIN_CAPTURED_EVENTS=25
AUTO_MEMORY_COOLDOWN_MS=300000
AUTO_MEMORY_DRAIN_POLL_INTERVAL_MS=5000
AUTO_MEMORY_DRAIN_TIMEOUT_MS=600000
AUTO_MEMORY_INDEX_LIMIT=500

# Auto Project Memory maintenance.
# Disabled by default; when enabled, runtime inbox writes and Session Memory ingest-created
# project candidates schedule a detached Project Memory maintenance worker after enough
# un-intaked inbox items or pending project candidates exist.
AUTO_PROJECT_MEMORY_MAINTENANCE=1
AUTO_PROJECT_MEMORY_MIN_PENDING_ITEMS=5
AUTO_PROJECT_MEMORY_COOLDOWN_MS=300000

# Optional SQLite dylib override for macOS extension loading.
# Myelin uses its vendored SQLite runtime when available and falls back to Homebrew SQLite on macOS.
# MYELIN_SQLITE_DYLIB_PATH=/opt/homebrew/opt/sqlite/lib/libsqlite3.dylib
