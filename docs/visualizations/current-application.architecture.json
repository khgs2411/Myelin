  "cards": [
    {
      "dot": "cyan",
      "title": "Native input \u2192 evidence",
      "items": [
        "The fixture preserves native values as deterministic JSON bytes.",
        "Capture stores raw facts. Session Memory starts in Step 3."
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence guarantees",
      "items": [
        "Replay compares source format and bytes within one Project.",
        "A conflict rolls back the batch. Exact replay keeps the original snapshot."
      ]
    },
    {
      "dot": "amber",
      "title": "Runtime and command boundary",
      "items": [
        "Application owns one database lifecycle; repositories use Sequelize models.",
        "Ordered receipts return to the CLI. ApplicationError supplies safe diagnostics."
      ]
    }
