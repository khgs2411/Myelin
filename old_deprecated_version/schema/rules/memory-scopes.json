{
  "rule": "memory-scopes",
  "description": "Scopes a query result may draw from; mirrors the MCP facade memory_scope field.",
  "scopes": [
    { "key": "project_wiki", "summary": "Curated project markdown wiki." },
    { "key": "project_session", "summary": "Project-scoped session continuity." },
    { "key": "project_state", "summary": "Generated project state and inventory." },
    { "key": "practice", "summary": "Canonical cross-project workflows (target design)." },
    { "key": "personal", "summary": "Durable user preferences (target design)." },
    { "key": "mixed", "summary": "Answer drew from more than one scope." },
    { "key": "none", "summary": "No scope could be consulted; degraded." }
  ],
  "phase_0_active": ["project_wiki", "project_state", "none"],
  "phase_0_deferred": ["project_session", "practice", "personal"]
}
