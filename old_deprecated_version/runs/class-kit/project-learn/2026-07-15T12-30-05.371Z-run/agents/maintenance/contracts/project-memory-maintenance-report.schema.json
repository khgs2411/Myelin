{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "dispositions": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "disposition": {
            "enum": [
              "applied_to_project_memory",
              "already_covered",
              "insufficient_evidence",
              "not_durable",
              "belongs_to_other_layer",
              "deferred_unsafe_change",
              "blocked_by_runner_failure"
            ]
          },
          "output_refs": {
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "reason": {
            "minLength": 1,
            "type": "string"
          },
          "source_kind": {
            "enum": [
              "project_candidate",
              "project_handoff"
            ]
          },
          "source_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_kind",
          "source_ref",
          "disposition",
          "reason",
          "output_refs"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "evidence_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "known_gaps": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "project_key": {
      "minLength": 1,
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "completed",
        "degraded",
        "failed"
      ]
    },
    "touched_paths": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "project_key",
    "status",
    "dispositions",
    "touched_paths",
    "evidence_paths",
    "known_gaps"
  ],
  "title": "ProjectMemoryMaintenanceReport",
  "type": "object"
}
